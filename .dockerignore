# Keep the image small and avoid copying anything private into it.

# The ** prefix matters: a bare "__pycache__/" matches only the top level,
# so webapp/__pycache__ would still be copied into the image.
**/__pycache__/
**/*.py[cod]

.git/
.gitignore
.gitattributes
.claude/

# portals.py contains a personal email address — never bake it into an image
portals.py

# Older drafts and the experimental sandbox
test.py
testv1.py
publicdatav0.py
open_source_tool.py
webapp-test/

# Platform launchers are useless inside a container
*.bat
*.command

# Downloaded data belongs on a volume, not in the image
downloads/
open-data-downloads/
